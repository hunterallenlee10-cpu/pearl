# Sends pre-order and cake requests to pearlbakerymd@gmail.com. Without it, forms fall back to a prefilled email.
RESEND_API_KEY=
# Sender address once a domain is verified in Resend (e.g. "Pearl Bakery <orders@pearlbakerymd.com>").
RESEND_FROM=
# Google Sheet published to the web as CSV (File > Share > Publish to web > CSV). See HOW-TO-UPDATE-THE-MENU.md.
WEEKEND_MENU_CSV_URL=
# Public site URL, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=
